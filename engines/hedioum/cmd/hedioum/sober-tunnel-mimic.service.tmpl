[Unit]
Description=sober-tunnel Daemon
# Order after ssh so the decoy sshd banner can be mirrored on boot.
After=network.target ssh.service sshd.service

[Service]
Type=simple
User=root
WorkingDirectory=/etc/sober-tunnel/standalone
# Open the listen port on the host firewall BEFORE the sandboxed daemon starts.
# The '+' runs this step with full privileges (outside the sandbox below), which
# the firewall edit needs; the long-running daemon itself stays locked down.
ExecStartPre=+/usr/local/bin/sober-tunnel-mimic --open-firewall
ExecStart=/usr/local/bin/sober-tunnel-mimic
Restart=always
RestartSec=5
LimitNOFILE=1048576

# --- Sandbox hardening ---
# CAP_NET_ADMIN is granted only to the Iran hub, and only so an opt-in TUN
# interface can be created/configured; the foreign stays bound to just
# CAP_NET_BIND_SERVICE.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE{{if .TunCapable}} CAP_NET_ADMIN{{end}}
AmbientCapabilities=CAP_NET_BIND_SERVICE{{if .TunCapable}} CAP_NET_ADMIN{{end}}
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/etc/sober-tunnel/standalone
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
